# ── Supabase ──────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (find in Project Settings → API)
VITE_SUPABASE_ANON_KEY=

# ── Ventures API ──────────────────────────────────────────────────────
# Base URL of your Ventures API instance (e.g. https://api.venturesgo.com)
VITE_VENTURES_BASE_URL=

# Site/client identifier used in API authentication
VITE_VENTURES_SITE=

# API username for your Ventures account
VITE_VENTURES_USERNAME=

# API password for your Ventures account
VITE_VENTURES_PASSWORD=

# ── Edge Function Secrets (set via Supabase dashboard, NOT here) ──────
# The following are configured as edge function secrets in the Supabase
# dashboard (Project Settings → Edge Functions → Secrets), not in this file:
#
#   SUPABASE_URL              – same as VITE_SUPABASE_URL (automatically provided)
#   SUPABASE_SERVICE_ROLE_KEY – service role key from Supabase dashboard
#   RESEND_API_KEY            – Resend API key for email notifications
#   RESEND_FROM_EMAIL         – from email address (e.g. notifications@your-org.com)
#   RESEND_FROM_NAME          – from display name (e.g. "Ventures Toolkit")
#   OPENAI_API_KEY            – OpenAI API key for AI document classification
